# Values for compose.yaml. Copy to .env (never committed) and set a password of your own.

# Password of the database user; Compose gives the same value to PostgreSQL and to the app.
DB_PASSWORD=change-me

# Optional: lowest log level of the app (DEBUG, INFO, WARNING, ERROR).
# APP_LOG_LEVEL=INFO

# Optional: course ids the app loads, separated by commas; only the synthetic demo course by default.
# A real course also needs its source files on this machine, e.g.
# APP_COURSES__ENABLED=demo,istqb_ctfl

# Optional: the commit the image is built from; set it in the shell before a build, e.g.
# $env:GIT_COMMIT = git rev-parse --short HEAD
# GIT_COMMIT=unknown
