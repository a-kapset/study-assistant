# Every value the local stack is configured with. Copy to .env (never committed) and set your own passwords.
# compose.yaml reads only this file and hands each service just the values it needs, so the app never
# gets the database owner's password. Each value says which app setting (APP_*) it becomes.

# --- Database ---
# Database name (APP_DB__NAME).
DB_NAME=study_assistant
# Host name the app and the migration run use to reach the database (APP_DB__HOST); compose.yaml gives the
# database service this name on the stack's network.
DB_HOST=db
# Port inside the stack's network (APP_DB__PORT); the database port is not published to this machine.
DB_PORT=5432
# Seconds to wait for a connection, and for /ready to get an answer (APP_DB__CONNECT_TIMEOUT_S).
DB_CONNECT_TIMEOUT_S=3

# The database owner, a superuser: only the migration run connects as it (APP_DB__USER / APP_DB__PASSWORD there).
# PostgreSQL sets this user and password only when it creates an empty database: changing them later needs
# `docker compose down -v`, which deletes the database.
DB_OWNER=study_assistant
DB_PASSWORD=change-me

# The role the app connects as, with row access only (APP_DB__USER / APP_DB__PASSWORD of the app,
# APP_SERVER_ROLE__NAME / APP_SERVER_ROLE__PASSWORD of the migration run, which creates the role or resets
# its password on every start). Lower-case letters, digits and "_"; a password different from DB_PASSWORD.
DB_APP_USER=app_rw
DB_APP_PASSWORD=change-me-too

# --- App ---
# Lowest level written to the log: DEBUG, INFO, WARNING or ERROR (APP_LOG_LEVEL).
APP_LOG_LEVEL=INFO
# Course ids to load, separated by commas, e.g. demo,istqb_ctfl (APP_COURSES__ENABLED). A real course also
# needs its source files on this machine; a course that cannot be loaded stops the app at startup.
APP_COURSES__ENABLED=demo
# Folder inside the app container where compose.yaml mounts the repository's courses/ (APP_COURSES__MANIFEST_DIR).
COURSES_DIR=/courses

# --- Build ---
# Commit the image is built from, shown by /v1/config (APP_GIT_COMMIT). A value set in the shell wins:
# $env:GIT_COMMIT = git rev-parse --short HEAD
GIT_COMMIT=unknown
