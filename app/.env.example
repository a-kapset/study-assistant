# Every variable the app reads, with its default. Copy to .env (never committed) and adjust.
# The app does not load this file itself: it reads the process environment only, and any other
# APP_* variable stops it at startup with the unknown names listed.

# Lowest level written to the log: DEBUG, INFO, WARNING or ERROR.
APP_LOG_LEVEL=INFO

# Commit the running code was built from; set by the build, "unknown" in a local run.
APP_GIT_COMMIT=unknown
