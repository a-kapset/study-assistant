# Every variable the app reads, with its default. Copy to .env (never committed) and adjust.
# The app does not load this file itself: it reads the process environment only, and any other
# APP_* variable stops it at startup with the unknown names listed.

# Lowest level written to the log: DEBUG, INFO, WARNING or ERROR.
APP_LOG_LEVEL=INFO

# Commit the running code was built from; set by the build, "unknown" in a local run.
APP_GIT_COMMIT=unknown

# PostgreSQL connection. The password has no default: without it the app does not start.
APP_DB__HOST=localhost
APP_DB__PORT=5432
APP_DB__NAME=study_assistant
APP_DB__USER=study_assistant
APP_DB__PASSWORD=change-me
# Seconds to wait for a connection, and for /ready to get an answer.
APP_DB__CONNECT_TIMEOUT_S=3

# Course manifests: one folder per course, each with a course.yaml. A relative path starts from the
# working directory; the default fits a run from app/.
APP_COURSES__MANIFEST_DIR=../courses
# Course ids to load, separated by commas, e.g. demo,other_course. None by default: courses are
# enabled on purpose, and a course that cannot be loaded stops the app at startup.
APP_COURSES__ENABLED=
